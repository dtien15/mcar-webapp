# =====================================================================
# MCAR WebApp - Cau hinh Apache / LiteSpeed
# Neu hosting bao loi 500 khi vao web: doi ten file nay thanh .htaccess.bak
# roi tao config/cauhinh.php voi dong: define('URL_DEP', false);
# =====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Chan truy cap truc tiep vao cac thu muc ma nguon
  RewriteRule ^(config|core|models|controllers|views|helpers|database)/ - [F,L]

  # Dieu huong moi request khong phai file/thu muc that vao index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# Chan tai ve cac file nhay cam
<IfModule mod_authz_core.c>
  <FilesMatch "\.(sql|md)$">
    Require all denied
  </FilesMatch>
</IfModule>
